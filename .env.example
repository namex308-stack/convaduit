# Supabase (required for auth + billing in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional JWKS (derived from project URL if omitted; unused by app code today)
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# App public origin (required in production — no silent localhost fallback).
# Local: http://localhost:3000
# Hosted production (canonical): https://www.convaudit.com
# Apex https://convaudit.com is rewritten to www (308 redirect + canonical URLs).
# Vercel production rejects localhost / non-HTTPS automatically.
# Non-Vercel hosts: set ENFORCE_PUBLIC_SITE_URL=1 to reject loopback the same way.
# Used for metadataBase, canonicals, sitemap, robots, Open Graph, JSON-LD, auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ENFORCE_PUBLIC_SITE_URL=1

# Google Search Console HTML-tag verification (optional).
# Set in Vercel production to emit <meta name="google-site-verification" …>.
# Do not commit the real token.
# GOOGLE_SITE_VERIFICATION=

# AI & scraping (optional — demo mode without these)
GEMINI_API_KEY=
# Optional Groq fallback when Gemini is unconfigured or fails (pillar analysis only).
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Optional override (default: gemini-3.5-flash-lite). gemini-2.5-flash-lite is unavailable to new keys.
# GEMINI_MODEL=gemini-3.5-flash-lite
FIRECRAWL_API_KEY=

# Paymob payments (optional)
# Never commit real secrets. Set values in Vercel / .env.local only.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
# Required in production: "test" or "live" (must match Paymob dashboard keys)
PAYMOB_MODE=test
# Optional per-method integration ids (fall back to PAYMOB_INTEGRATION_ID)
# PAYMOB_INTEGRATION_CARD_ID=
# PAYMOB_INTEGRATION_WALLET_ID=
# PAYMOB_INTEGRATION_INSTAPAY_ID=
# PAYMOB_INTEGRATION_BANK_ID=
# PAYMOB_INTEGRATION_KIOSK_ID=
# Processed callback (HMAC webhook) in the Paymob dashboard:
#   {NEXT_PUBLIC_APP_URL}/api/webhook/paymob

# Upstash Redis rate limiting (required in production — requests denied when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth is configured in the Supabase dashboard (Auth → Providers → Google).
# Do not put Google client secrets in this Next.js app unless you add a custom IdP flow.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Free website-analysis integrations (server-side only — never expose to the browser).
# All of these are optional. A missing key skips that check; the audit still completes.
#
# PageSpeed Insights API — free, 25k queries/day. Works without a key (shared public quota).
# Create a key: https://developers.google.com/speed/docs/insights/v5/get-started
# GOOGLE_PAGESPEED_API_KEY=
#
# Web Risk Lookup API (`uris.search` only) — free for the first 100,000 lookups/month.
# Enable Web Risk API on a Google Cloud project, then create an API key restricted to Web Risk.
# https://cloud.google.com/web-risk/docs/lookup-api
# If unset, the check is skipped. Never uses the paid Update/hashes APIs.
# GOOGLE_WEB_RISK_API_KEY=
#
# Optional shared key used when the specific PageSpeed / Web Risk vars above are empty.
# Restrict it to PageSpeed Insights API + Web Risk API only.
# GOOGLE_API_KEY=
#
# SSL/TLS is checked with a direct handshake (no API, no key).
# IP/Geo uses GeoJS (free, no key) with ipwho.is as fallback (free, no key).
# WHOIS uses IANA RDAP bootstrap + registry RDAP servers (no WhoisXML, no key).

# Google Analytics 4 is wired in src/app/layout.tsx (G-MDR2NP5CJ3).
# Strict CSP (next.config.ts → src/lib/security/content-security-policy.ts):
#   script-src: 'self' 'unsafe-inline' googletagmanager.com, va.vercel-scripts.com (dev)
#   connect-src: 'self', NEXT_PUBLIC_SUPABASE_URL (+ *.supabase.co), GA/Vercel analytics
#   img-src: 'self' data: cdn.firecrawl.dev, https: (merchant audit images + Google avatars)
#   frame-src: 'none' (Paymob/Google OAuth use top-level redirects, not embeds)
# Server-only APIs (Firecrawl, Gemini, Paymob, Resend, Upstash) are not in browser CSP.

# Resend email (optional — weekly AI report + transactional mail)
# Both vars required to send. Missing either disables email (reports still generate).
# Test with Resend's onboarding sender; production uses the verified ConvAudit domain:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=ConvAudit <alihashem@convaudit.com>

# Cron auth for /api/cron/* (required in production)
# CRON_SECRET=

# Automation engine (infrastructure only — keep OFF in production)
# Master switch for /api/cron/automation/* dispatcher. Default: disabled.
# AUTOMATION_ENABLED=false
# When the master switch is on, dry-run is still the default (no side effects).
# Set AUTOMATION_DRY_RUN=false only for intentional live runs.
# AUTOMATION_DRY_RUN=true
# Optional per-job overrides (require AUTOMATION_ENABLED=true):
# AUTOMATION_JOB_WEEKLY_SCAN=true
# AUTOMATION_JOB_MONTHLY_SCAN=true
# AUTOMATION_JOB_COMPETITOR_MONITORING=true
# AUTOMATION_JOB_HEALTH_UPDATES=true
# AUTOMATION_JOB_WEEKLY_REPORTS=true
# AUTOMATION_JOB_AI_ALERTS=true
# Do NOT add /api/cron/automation/* paths to vercel.json until activation.

# Competitor monitor: live crawl is OFF in development by default.
# Production scheduled jobs crawl when NODE_ENV=production.
# Set true only for intentional local crawl tests:
# COMPETITOR_MONITOR_ALLOW_CRAWL=true

# Local tryout: unlock Business features (ignored when NODE_ENV=production)
NEXT_PUBLIC_DEV_UNLOCK_ALL=true

# E2E (Playwright) — never commit real passwords
# CI suite: npm run test:e2e
# Live smoke (crawl/AI): E2E_SMOKE=1 npm run test:e2e:smoke
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
# E2E_STORE_URL=https://example-store.com
# E2E_EXPECT_FREE_PLAN=1
# E2E_SMOKE=1
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Supabase Auth redirect URLs to allow in the dashboard:
#   {NEXT_PUBLIC_APP_URL}/auth/callback
#   {NEXT_PUBLIC_APP_URL}/api/oauth/callback  (legacy forwarder)
#
# Production dashboard (not set via .env / migrations):
#   Enable Auth → Leaked password protection (HaveIBeenPwned).
#   See docs/supabase-security-hardening.md
